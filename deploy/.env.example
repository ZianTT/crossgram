# Copy this file to deploy/.env (git-ignored) before running docker compose.
# Every value can also be exported in the shell; the shell wins over this file.
# Everything else defaults in deploy/docker-compose.yml, and deploy/README.md
# documents the build arguments and memory knobs (image variants, QQ features,
# limits, shm size).

# Address Telegram clients connect to. Required.
CROSSGRAM_PUBLIC_HOST=203.0.113.10

# MTProto port, both published on the host and announced to clients.
CROSSGRAM_PORT=4430

# Interface the MTProto port is published on. Use 127.0.0.1 behind a reverse proxy.
CROSSGRAM_BIND=0.0.0.0

# WebUI port, published on 127.0.0.1 only.
CROSSGRAM_WEBUI_PORT=3140

# PostgreSQL password. Required; the role and database are fixed in the compose
# file as crossgram/crossgram.
# openssl rand -hex 32
CROSSGRAM_POSTGRES_PASSWORD=

# Persistent secret for the self-hosted Telegram Bot API. Required.
# openssl rand -base64 48 | tr -d '\n'
TELEGRAM_BOT_TOKEN_VERIFIER_SECRET=

# Bearer token shared with the QQNT bridge. Empty disables authentication.
# openssl rand -hex 32
QQNT_BRIDGE_TOKEN=

# Set these when the QQNT bridge runs outside the compose project; a container
# usually reaches the host as host.docker.internal (depending on the runtime).
# CROSSGRAM_QQNT_ENDPOINT=http://host.docker.internal:18767/v1
# CROSSGRAM_QQNT_WS_ENDPOINT=ws://host.docker.internal:18767/v1/events/ws
